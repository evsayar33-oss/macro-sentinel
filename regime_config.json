{
  "system_architecture": {
    "module_name": "macro-event-interpretation-system",
    "version": "3.1",
    "principles": {
      "mutual_exclusivity": true,
      "active_regime_count": 1,
      "normalization": "52_week_rolling_z_score",
      "hysteresis_confirmation_period_weeks": 2,
      "scoring_type": "deterministic",
      "point_in_time_only": true,
      "fail_closed_on_data_failure": true,
      "minimum_history_days": 126,
      "dynamic_event_thresholds": true,
      "unknown_event_guard": true,
      "trailing_reference_excludes_current_observation": true,
      "metadata_preservation": true,
      "market_closed_hold": true,
      "single_source_of_truth_for_allocation": "regime_config.json",
      "switch_confirmation_observations": 2,
      "allocation_source_of_truth": "regimes[].default_allocation",
      "production_strategy_layer": "adaptive_strategy_layer_v3",
      "capital_preservation_governor": true
    },
    "predictive_validation_layer": "v3.1_empirical_point_in_time"
  },
  "priority_rules": {
    "category_priority": [
      "SHOCK_REGIMES (1, 2, 3, 4)",
      "RISK_ON_REGIME (5)"
    ],
    "conflict_resolution": "Hard shock states first; then persistent real-rate constraint; otherwise risk-on. Within simultaneous hard shocks, highest absolute same-scale trigger Z wins.",
    "special_conflict_cases": [
      {
        "conflict": "Regime_1 vs Regime_3",
        "resolution": "IF T10YIE 52w_Z > +0.5 THEN Regime_1 ELSE Regime_3"
      }
    ],
    "fallback_rule": "If no named regime is confirmed, retain current state during hysteresis; a persistent-rate constraint is distinct from a daily rate shock."
  },
  "regimes": [
    {
      "id": 1,
      "name": "Küresel Enflasyon & Stagflasyon Şoku",
      "type": "SHOCK",
      "triggers": {
        "logic": "AND",
        "conditions": [
          {
            "indicator": "Petrol Şoku",
            "ticker": "Brent or WTI Spot",
            "formula": "20_day_return_52w_zscore",
            "threshold": "Z > 1.4 OR oil trend Z >= 2.0",
            "threshold_val": 1.4
          },
          {
            "indicator": "Navlun/Ticaret Çöküşü",
            "ticker": "Baltic Dry Index (BDI)",
            "formula": "52w_zscore_level",
            "threshold": "Z < -0.9 OR Z > 1.5",
            "threshold_val": -0.9
          }
        ]
      },
      "confirmations": {
        "logic": "AND",
        "conditions": [
          {
            "indicator": "Kredi Stresi",
            "ticker": "FRED:BAMLH0A0HYM2 (HY OAS)",
            "formula": "52w_zscore",
            "threshold": "Z > 0.5",
            "threshold_val": 0.5
          },
          {
            "indicator": "Hisse/Tahvil Korelasyonu",
            "ticker": "SPX & UST10Y Returns",
            "formula": "60_day_rolling_correlation",
            "threshold": "correlation > 0",
            "threshold_val": 0.0
          }
        ]
      },
      "default_allocation": {
        "cash": 40,
        "gold": 25,
        "commodity": 30,
        "bond": 5,
        "equity": 0,
        "crypto": 0
      }
    },
    {
      "id": 2,
      "name": "Sistemik Likidite Şoku & Carry Çöküşü",
      "type": "SHOCK",
      "triggers": {
        "logic": "OR_OR_OR",
        "conditions": [
          {
            "indicator": "Geniş Dolar Gücü",
            "ticker": "FRED:DTWEXBGS",
            "formula": "5_day_change_52w_zscore",
            "threshold": "Z > 1.0",
            "threshold_val": 1.0
          },
          {
            "indicator": "JPY Carry Unwind",
            "ticker": "USD/JPY Spot",
            "formula": "1_day_change_52w_zscore",
            "threshold": "Z < -2.0",
            "threshold_val": -2.0
          },
          {
            "indicator": "Volatilite Şoku",
            "ticker": "FRED:VIXCLS (VIX)",
            "formula": "level_52w_zscore",
            "threshold": "Z > 1.5",
            "threshold_val": 1.5
          }
        ]
      },
      "confirmations": {
        "logic": "AND",
        "conditions": [
          {
            "indicator": "Risk Varlığı Satışı",
            "ticker": "BTC + SPX Equal-Weighted Basket",
            "formula": "5_day_return_52w_zscore",
            "threshold": "Z < -1.5",
            "threshold_val": -1.5
          }
        ]
      },
      "default_allocation": {
        "cash": 95,
        "gold": 0,
        "commodity": 0,
        "bond": 5,
        "equity": 0,
        "crypto": 0
      }
    },
    {
      "id": 3,
      "name": "Reel Faiz Şoku",
      "type": "SHOCK",
      "triggers": {
        "logic": "AND",
        "conditions": [
          {
            "indicator": "Ana Tetikleyici (Reel Faiz)",
            "ticker": "FRED:DFII10 (10Y TIPS)",
            "formula": "daily_change_trailing_z OR persistent_level_constraint",
            "threshold": "daily Z > 1.4 OR TIPS >= 2.0% OR level Z > 1.0 OR level percentile >= 75",
            "threshold_val": 1.4
          },
          {
            "indicator": "Ayrıştırıcı (Breakeven Enflasyon)",
            "ticker": "FRED:T10YIE",
            "formula": "52w_zscore",
            "threshold": "Z < 0.5",
            "threshold_val": 0.5
          }
        ]
      },
      "sub_types": [
        {
          "label": "Bear Steepener (Enflasyon/Term Premium)",
          "condition": "ΔDGS2 < 0 AND ΔDGS10 > 0"
        },
        {
          "label": "Bear Steepener (Fed Varyantı)",
          "condition": "ΔDGS2 > 0 AND ΔDGS10 > 0 AND ΔDGS10 > ΔDGS2"
        },
        {
          "label": "Bear Flattener (Fed Sıkılaştırma Baskın)",
          "condition": "ΔDGS2 > 0 AND ΔDGS10 > 0 AND ΔDGS2 > ΔDGS10"
        },
        {
          "label": "Bull Flattener/Steepener (Gevşeme - Tetiklemez)",
          "condition": "ΔDGS2 < 0 AND ΔDGS10 < 0"
        }
      ],
      "default_allocation": {
        "cash": 67.26,
        "gold": 11.0,
        "commodity": 2.94,
        "bond": 10.0,
        "equity": 8.8,
        "crypto": 0.0
      }
    },
    {
      "id": 4,
      "name": "Kredi Temerrüt Baskısı",
      "type": "SHOCK",
      "triggers": {
        "logic": "AND",
        "conditions": [
          {
            "indicator": "Yüksek Getirili Spread",
            "ticker": "FRED:BAMLH0A0HYM2 (HY OAS)",
            "formula": "52w_zscore_level",
            "threshold": "Z > 2.0",
            "threshold_val": 2.0
          },
          {
            "indicator": "Trend Teyidi",
            "ticker": "FRED:BAMLH0A0HYM2 (HY OAS)",
            "formula": "10_day_rolling_slope",
            "threshold": "gradual_expansion (slope > 0)",
            "threshold_val": 0.0
          }
        ]
      },
      "confirmations": {
        "logic": "AND",
        "conditions": [
          {
            "indicator": "Yatırım Yapılabilir Spread",
            "ticker": "FRED:BAMLC0A0CM (IG OAS)",
            "formula": "52w_zscore_level",
            "threshold": "Z > 1.0",
            "threshold_val": 1.0
          }
        ]
      },
      "default_allocation": {
        "cash": 65,
        "gold": 20,
        "commodity": 0,
        "bond": 15,
        "equity": 0,
        "crypto": 0
      }
    },
    {
      "id": 5,
      "name": "Küresel Likidite Rallisi (Risk-On)",
      "type": "RISK_ON",
      "triggers": {
        "logic": "AND",
        "conditions": [
          {
            "indicator": "Kredi Gücü",
            "ticker": "FRED:BAMLH0A0HYM2 (HY OAS)",
            "formula": "52w_zscore",
            "threshold": "Z < -0.5",
            "threshold_val": -0.5
          },
          {
            "indicator": "Dolar Rejimi",
            "ticker": "FRED:DTWEXBGS",
            "formula": "52w_zscore",
            "threshold": "Z <= 0.6 (Zayıf/Stabil Dolar)",
            "threshold_min": -2.5,
            "threshold_max": 0.6
          },
          {
            "indicator": "Volatilite",
            "ticker": "VIX or MOVE",
            "formula": "252_day_percentile",
            "threshold": "percentile < 32",
            "threshold_val": 32.0
          },
          {
            "indicator": "Net Dolar Likiditesi",
            "ticker": "CMS_NDL_SERIES",
            "formula": "52w_zscore",
            "threshold": "Z > -0.65",
            "threshold_val": -0.65
          }
        ]
      },
      "sub_types_post_hoc": [
        {
          "label": "Reflasyonist Risk-On",
          "condition": "DTWEXBGS_Z < -0.5 AND Gold_Price == RISING"
        },
        {
          "label": "Klasik Goldilocks Risk-On",
          "condition": "-1.0 <= DTWEXBGS_Z <= 0.5 AND Gold_Price == FLAT_OR_FALLING"
        }
      ],
      "default_allocation": {
        "cash": 10,
        "gold": 10,
        "commodity": 0,
        "bond": 0,
        "equity": 70,
        "crypto": 10
      }
    }
  ],
